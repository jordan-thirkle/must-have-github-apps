---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import JsonLd from '@/components/JsonLd.astro';
import { entryTypeLabel, formatDate, formatStars, reviewState } from '@/lib/directory';

export async function getStaticPaths() {
  const apps = await getCollection('apps');
  return apps
    .filter(({ data }) => data.status !== 'removed')
    .map((app) => ({ params: { slug: app.data.slug }, props: { app } }));
}

const { app } = Astro.props;
const { data } = app;
const allApps = await getCollection('apps');
const appSlugs = new Set(
  allApps
    .filter(({ data: appData }) => appData.status !== 'removed')
    .map(({ data: appData }) => appData.slug),
);
const description = data.seoDescription || data.summary;
const actionUrls = new Set([data.officialUrl, data.documentationUrl]);
const evidenceSources = data.sources.filter((source) => !actionUrls.has(source.url));
const review = reviewState(data.reviewedAt, data.nextReviewAt);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: data.name,
  description,
  url: Astro.url.href,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Web',
  provider: { '@type': 'Organization', name: data.vendor },
  isAccessibleForFree: data.freeTier,
};
---

<BaseLayout
  title={data.seoTitle || `${data.name}: Permissions, Setup, and Alternatives`}
  description={description}
  type="article"
>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Apps', href: '/apps/' }, { label: data.name }]} />
  </div>
  <section class="container detail-grid">
    <div class="detail-header">
      <p class="eyebrow mono">{entryTypeLabel(data.entryType)} · {data.vendor}</p>
      <h1 class="display">{data.name}</h1>
      <p class="summary">{data.summary}</p>
      <div class="detail-actions">
        <a class="button" href={data.officialUrl}>Official site <span aria-hidden="true">↗</span></a
        ><a class="button secondary" href={data.documentationUrl}>Documentation</a><a
          class="button secondary"
          href={`/agent-prompt/?tools=${data.slug}`}>Copy agent prompt</a
        >
        {
          data.githubRepository && (
            <a class="button secondary" href={data.githubRepository.url}>
              GitHub repository <span aria-hidden="true">↗</span>
            </a>
          )
        }
      </div>
    </div>
    <aside class="detail-aside" aria-label="At a glance">
      <dl class="fact-list">
        <div class="fact"><dt>Setup effort</dt><dd>{data.setupLevel}</dd></div>
        <div class="fact"><dt>Ongoing maintenance</dt><dd>{data.maintenanceLevel}</dd></div>
        <div class="fact">
          <dt>Pricing model</dt><dd>{data.pricingModel}{data.freeTier ? ' · free option' : ''}</dd>
        </div>
        <div class="fact">
          <dt>Does data go outside GitHub?</dt><dd>{data.dataLeavesGitHub}</dd>
        </div>
        {
          data.githubRepository?.stars !== undefined && (
            <div class="fact">
              <>
                <dt>GitHub stars</dt>
                <dd>
                  <>
                    <span aria-label={`${formatStars(data.githubRepository.stars)} GitHub stars`}>
                      ★ {formatStars(data.githubRepository.stars)}
                    </span>
                    <small> · checked {formatDate(data.githubRepository.starsCheckedAt!)}</small>
                  </>
                </dd>
              </>
            </div>
          )
        }
        <div class="fact">
          <dt>Review status</dt><dd>{review.overdue ? 'Review due' : 'Reviewed'}</dd>
        </div>
        <div class="fact"><dt>Last reviewed</dt><dd>{formatDate(data.reviewedAt)}</dd></div>
        <div class="fact"><dt>Next review</dt><dd>{formatDate(data.nextReviewAt)}</dd></div>
      </dl>
    </aside>
  </section>
  <JsonLd data={schema} />
  <article class="container detail-content">
    <h2>What this tool does</h2><p>{data.problem}</p>
    <h2>When it may fit</h2><ul>{data.bestFor.map((item) => <li>{item}</li>)}</ul>
    <h2>When it may not fit</h2><ul>{data.notFor.map((item) => <li>{item}</li>)}</ul>
    <h2>Access and permissions</h2><p>{data.accessSummary}</p><table class="permission-table">
      <caption>Permissions for {data.name}</caption>
      <thead
        ><tr
          ><th scope="col">Resource</th><th scope="col">Access</th><th scope="col">Scope</th><th
            scope="col">Purpose</th
          ></tr
        ></thead
      ><tbody
        >{
          data.permissions.map((permission) => (
            <tr>
              <>
                <td>{permission.resource}</td>
                <td>{permission.access}</td>
                <td>{permission.scope}</td>
                <td>{permission.purpose}</td>
              </>
            </tr>
          ))
        }</tbody
      >
    </table>
    <h2>Pricing, privacy, and data</h2><p><strong>Pricing:</strong> {data.pricingSummary}</p><p>
      <strong>Privacy:</strong>
      {data.privacySummary}
    </p><p><strong>Data it may access:</strong> {data.dataAccess.join(', ')}.</p>
    <h2>Strengths</h2><ul>{data.strengths.map((item) => <li>{item}</li>)}</ul>
    <h2>Limitations</h2><ul>{data.limitations.map((item) => <li>{item}</li>)}</ul>
    <h2>Alternatives</h2><p>
      {
        data.alternatives.map((alternative) =>
          appSlugs.has(alternative) ? (
            <a href={`/apps/${alternative}/`} style="margin-right: 1.2rem">
              {alternative}
            </a>
          ) : (
            <span style="margin-right: 1.2rem">{alternative}</span>
          ),
        )
      }
    </p>
    <h2>Evidence checked</h2><ul class="sources">
      {
        evidenceSources.map((source) => (
          <li>
            <a href={source.url} rel="nofollow">
              {source.label}
            </a>{' '}
            <span class="mono muted">
              ({source.type}, checked {formatDate(source.checkedAt)})
            </span>
          </li>
        ))
      }
    </ul>
  </article>
</BaseLayout>
