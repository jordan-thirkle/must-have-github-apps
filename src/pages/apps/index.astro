---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppCard from '@/components/AppCard.astro';
import Icon from '@/components/Icon.astro';
import { entryTypeLabel, getApps, getCategories } from '@/lib/directory';

const apps = await getApps();
const categories = await getCategories();
const entryTypes = [...new Set(apps.map(({ data }) => data.entryType))];
---

<BaseLayout
  title="GitHub Apps Directory | Must-Have GitHub Apps"
  description="Compare reviewed GitHub Apps, native features, Actions, and integrations by job, access, setup, pricing, privacy, and upkeep."
>
  <section class="container page-intro">
    <p class="eyebrow">Directory</p>
    <h1 class="display">Compare GitHub tools by job, access, and upkeep.</h1>
    <p>
      Every entry has one source record, dated evidence, and a clear account of what it can access.
    </p>
  </section>
  <section class="container section">
    <form class="filter-panel" id="filter-form" aria-labelledby="filter-heading">
      <h2 id="filter-heading" class="sr-only">Filter the directory</h2>
      <div class="filter-search">
        <label for="app-search">Search entries</label><div class="search-input">
          <Icon name="search" size={16} /><input
            id="app-search"
            type="search"
            placeholder="Tool, job, or vendor"
            autocomplete="off"
          />
        </div>
      </div>
      <label
        >Problem to solve<select id="filter-category"
          ><option value="">All jobs</option>{
            categories.map((category) => (
              <option value={category.data.slug}>{category.data.name}</option>
            ))
          }</select
        ></label
      >
      <label
        >Tool type<select id="filter-type"
          ><option value="">All types</option>{
            entryTypes.map((type) => <option value={type}>{entryTypeLabel(type)}</option>)
          }</select
        ></label
      >
      <label
        >Setup effort<select id="filter-setup" aria-describedby="setup-help"
          ><option value="">Any setup effort</option><option value="low">Low</option><option
            value="medium">Medium</option
          ><option value="high">High</option></select
        ></label
      >
      <label
        >Sort<select id="filter-sort"
          ><option value="recommended">Recommended</option><option value="setup"
            >Lowest setup effort</option
          ><option value="name">Name</option></select
        ></label
      >
      <button class="reset-button" id="filter-reset" type="button">Reset</button>
      <p id="setup-help" class="filter-help">
        Low is easy to start. High needs more setup and ongoing work.
      </p>
    </form>
    <div class="toolbar mono">
      <span id="app-count" role="status" aria-live="polite"
        >Showing {apps.length} of {apps.length} reviewed tools.</span
      ><span>Facts are dated and sourced</span>
    </div>
    <div class="app-grid" id="app-grid">{apps.map((app) => <AppCard app={app.data} />)}</div>
    <p id="app-empty" class="empty-state" hidden>
      <strong>No entries match those filters.</strong><span
        >Clear one filter or browse every reviewed entry.</span
      ><button class="button secondary" id="empty-reset" type="button">Clear filters</button>
    </p>
  </section>
  <script>
    const search = document.querySelector<HTMLInputElement>('#app-search');
    const controls = [...document.querySelectorAll<HTMLSelectElement>('.filter-panel select')];
    const cards = [...document.querySelectorAll<HTMLElement>('[data-app-card]')];
    const count = document.querySelector<HTMLElement>('#app-count');
    const empty = document.querySelector<HTMLElement>('#app-empty');
    const reset = () => {
      if (search) search.value = '';
      controls.forEach((control) => {
        control.value = control.id === 'filter-sort' ? 'recommended' : '';
      });
      apply();
    };
    const apply = () => {
      const query = search?.value.trim().toLowerCase() || '';
      const category = document.querySelector<HTMLSelectElement>('#filter-category')?.value || '';
      const type = document.querySelector<HTMLSelectElement>('#filter-type')?.value || '';
      const setup = document.querySelector<HTMLSelectElement>('#filter-setup')?.value || '';
      const sort =
        document.querySelector<HTMLSelectElement>('#filter-sort')?.value || 'recommended';
      const grid = document.querySelector<HTMLElement>('#app-grid');
      const visible = cards.filter((card) => {
        const matches =
          (!query || card.dataset.search?.toLowerCase().includes(query)) &&
          (!category || card.dataset.category?.split(' ').includes(category)) &&
          (!type || card.dataset.entryType === type) &&
          (!setup || card.dataset.setup === setup);
        card.hidden = !matches;
        card.classList.toggle('motion-enter', matches);
        if (matches) requestAnimationFrame(() => card.classList.remove('motion-enter'));
        return matches;
      });
      [...cards]
        .sort((a, b) =>
          sort === 'name'
            ? (a.querySelector('h3')?.textContent || '').localeCompare(
                b.querySelector('h3')?.textContent || '',
              )
            : sort === 'setup'
              ? (a.dataset.setup || '').localeCompare(b.dataset.setup || '')
              : 0,
        )
        .forEach((card) => grid?.append(card));
      if (count) count.textContent = `Showing ${visible.length} of ${cards.length} reviewed tools.`;
      if (empty) empty.hidden = visible.length > 0;
    };
    search?.addEventListener('input', apply);
    controls.forEach((control) => control.addEventListener('change', apply));
    document.querySelector('#filter-reset')?.addEventListener('click', reset);
    document.querySelector('#empty-reset')?.addEventListener('click', reset);
    document
      .querySelector<HTMLFormElement>('#filter-form')
      ?.addEventListener('submit', (event) => event.preventDefault());
  </script>
</BaseLayout>
