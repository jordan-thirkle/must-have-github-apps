---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppCard from '@/components/AppCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import Icon from '@/components/Icon.astro';
import { categoryPath, getApps, getCategories, siteDescription, siteName } from '@/lib/directory';

const apps = await getApps();
const categories = await getCategories();
const featured = apps.filter(({ data }) => data.featured);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description: siteDescription,
  url: Astro.site,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.site}apps/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="Must-Have GitHub Apps | Security, Automation, and Developer Tools"
  description="A public GitHub Apps directory for security tools, Actions, integrations, and repository automation, with clear access, cost, and upkeep notes."
>
  <JsonLd data={schema} />
  <section class="container hero hero-centered">
    <div class="hero-copy-block">
      <p class="eyebrow">A GitHub Apps directory, built in public</p>
      <h1 class="display">Find the tools your repository needs.</h1>
      <p class="hero-copy">
        Compare GitHub Apps, Actions, security tools, and integrations by access, cost, and upkeep.
      </p>
      <div class="hero-actions">
        <a class="button" href="/apps/">Browse the directory <Icon name="arrow" size={15} /></a>
        <a class="button secondary" href="/collections/">Start with the baseline</a>
      </div>
      <p class="hero-proof">Reviewed records, dated sources, and clear permission notes.</p>
      <p><a class="text-link" href="/agent-prompt/">Need an agent to help? Copy a prompt.</a></p>
    </div>
  </section>

  <section class="container section rule" aria-labelledby="start-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Browse by problem</p>
        <h2 id="start-heading" class="display">Choose what you need to fix.</h2>
      </div>
      <p>Pick a problem to see the relevant tools.</p>
    </div>
    <div class="category-list">
      {
        categories.map((category) => (
          <a class="category-row" href={categoryPath(category.data.slug)}>
            <span class="category-number mono">{String(category.data.order).padStart(2, '0')}</span>
            <span>
              <>
                <h3>{category.data.name}</h3>
                <p>{category.data.description}</p>
              </>
            </span>
            <span class="category-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Featured tools</p>
        <h2 id="featured-heading" class="display">What’s in the directory now.</h2>
      </div>
      <div class="section-actions">
        <a class="text-link" href="/apps/">View all apps <Icon name="arrow" size={15} /></a><a
          class="text-link"
          href="https://github.com/jordan-thirkle/must-have-github-apps">★ Star this project</a
        >
      </div>
    </div>
    <div class="app-grid">
      {featured.map((app) => <AppCard app={app.data} />)}
    </div>
  </section>

  <section class="container section">
    <div class="callout">
      <div>
        <p class="eyebrow">New repository?</p>
        <h2 class="display">Start with the security baseline.</h2>
      </div>
      <a class="text-link" href="/collections/new-repository-baseline/"
        >Open the baseline <Icon name="arrow" size={15} /></a
      >
    </div>
  </section>
</BaseLayout>
