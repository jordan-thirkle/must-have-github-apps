---
import BaseLayout from '@/layouts/BaseLayout.astro';
import AppCard from '@/components/AppCard.astro';
import JsonLd from '@/components/JsonLd.astro';
import Icon from '@/components/Icon.astro';
import { categoryPath, getApps, getCategories, siteDescription, siteName } from '@/lib/directory';

const apps = await getApps();
const categories = await getCategories();
const featured = apps.filter(({ data }) => data.featured);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: siteName,
  description: siteDescription,
  url: Astro.site,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${Astro.site}apps/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout
  title="Must-Have GitHub Apps | Security, Automation, and Developer Tools"
  description="A security-first directory of GitHub Apps, integrations, Actions, and developer tools, reviewed for permissions, setup, pricing, privacy, and trade-offs."
>
  <JsonLd data={schema} />
  <section class="container hero">
    <div class="hero-copy-block">
      <p class="eyebrow">GitHub tools, compared clearly</p>
      <h1 class="display">Find the tools your repository is missing.</h1>
      <p class="hero-copy">
        Security scanners, dependency updates, review checks, and automation, compared by access,
        upkeep, and evidence.
      </p>
    </div>
    <aside class="hero-note">
      <p class="eyebrow">Choose your next step</p>
      <strong>Start with the risk in front of you.</strong>
      <p>
        Use the baseline for a new repository, or browse the directory when you already know the
        gap.
      </p>
      <div class="hero-actions">
        <a class="button" href="/collections/">Open the baseline <Icon name="arrow" size={15} /></a>
        <a class="text-link" href="/apps/">Browse all tools</a>
      </div>
    </aside>
  </section>

  <section class="container section rule" aria-labelledby="start-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Browse by job</p>
        <h2 id="start-heading" class="display">Start with the gap, not the vendor.</h2>
      </div>
      <p>Choose one problem. See the tools, permissions, and trade-offs in one place.</p>
    </div>
    <div class="category-list">
      {
        categories.map((category) => (
          <a class="category-row" href={categoryPath(category.data.slug)}>
            <span class="category-number mono">{String(category.data.order).padStart(2, '0')}</span>
            <span>
              <>
                <h3>{category.data.name}</h3>
                <p>{category.data.description}</p>
              </>
            </span>
            <span class="category-arrow" aria-hidden="true">
              ↗
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section class="container section" aria-labelledby="featured-heading">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Reviewed entries</p>
        <h2 id="featured-heading" class="display">A short list to get moving.</h2>
      </div>
      <div class="section-actions">
        <a class="text-link" href="/apps/">View all apps <Icon name="arrow" size={15} /></a><a
          class="text-link"
          href="https://github.com/jordan-thirkle/must-have-github-apps">★ Star this project</a
        >
      </div>
    </div>
    <div class="app-grid">
      {featured.map((app) => <AppCard app={app.data} />)}
    </div>
  </section>

  <section class="container section">
    <div class="callout">
      <div>
        <h2 class="display">Most repositories start without a security baseline.</h2><p>
          Use the checklist, then add only what your project can maintain.
        </p>
      </div>
      <a class="text-link" href="/collections/new-repository-baseline/"
        >Open the baseline <Icon name="arrow" size={15} /></a
      >
    </div>
  </section>
</BaseLayout>
