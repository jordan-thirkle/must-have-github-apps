---
import Icon from './Icon.astro';
import { appPath, entryTypeLabel, formatDate, formatStars, reviewState } from '@/lib/directory';
const { app } = Astro.props;
const category = app.categories[0];
const categoryIcon =
  category === 'security' ? 'shield' : category === 'dependencies' ? 'package' : 'workflow';
const review = reviewState(app.reviewedAt, app.nextReviewAt);
---

<a
  class="app-card"
  data-app-card
  data-search={`${app.name} ${app.vendor} ${app.summary} ${app.categories.join(' ')} ${app.tags.join(' ')}`}
  data-category={app.categories[0]}
  data-entry-type={app.entryType}
  data-setup={app.setupLevel}
  data-pricing={app.pricingModel}
  href={appPath(app.slug)}
>
  <div>
    <div class="app-meta mono">
      <span class="app-type"
        ><Icon name={categoryIcon} size={15} /> {entryTypeLabel(app.entryType)}</span
      >
      <span>{app.vendor}</span>
    </div>
    <h3>{app.name}</h3>
    <p>{app.summary}</p>
  </div>
  <div class="app-footer mono">
    <span>{app.setupLevel} setup · {app.pricingModel}</span>
    {
      app.githubRepository?.stars !== undefined ? (
        <span
          aria-label={`${formatStars(app.githubRepository.stars)} GitHub stars, checked ${formatDate(app.githubRepository.starsCheckedAt!)}`}
        >
          <span aria-hidden="true">★</span> {formatStars(app.githubRepository.stars)} stars
        </span>
      ) : (
        <span>Last checked {review.lastChecked}</span>
      )
    }
  </div>
</a>
